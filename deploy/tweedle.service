[Unit]
Description=Tweedle monitoring agent
Documentation=https://github.com/impiperl/Tweedle
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/tweedle serve --config /etc/tweedle/config.yaml
# With listen: podman:NETWORK:PORT the API listens on the network's gateway,
# which only exists once podman has set up the bridge; until then the start
# fails and is retried.
Restart=always
RestartSec=10
# Root is needed for podman (root containers) and to read all processes.
User=root

[Install]
WantedBy=multi-user.target
